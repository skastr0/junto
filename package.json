{
  "name": "@skastr0/vellum",
  "version": "0.1.0",
  "description": "Vellum Command — the deep-field station for multi-agent fleets on macOS.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/vellum.git"
  },
  "bugs": {
    "url": "https://github.com/skastr0/vellum/issues"
  },
  "homepage": "https://github.com/skastr0/vellum#readme",
  "trustedDependencies": ["electron", "node-pty"],
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bash scripts/build-app.sh --fast",
    "build:pack": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "react-doctor --no-telemetry src/renderer",
    "test:e2e": "electron-vite build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:fast": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:perf": "electron-vite build && playwright test --config e2e/playwright.config.ts e2e/scenarios/canvas-interaction-perf.spec.ts",
    "test:browser:electron": "bun scripts/browser-electron-containment-probe.ts",
    "test:browser:crash-recovery": "bun scripts/browser-electron-renderer-crash-recovery-probe.ts",
    "test:browser:profile-wipe": "bun scripts/browser-electron-profile-wipe-probe.ts",
    "verify": "bun run typecheck && bun run test && electron-vite build",
    "app:build": "bash scripts/build-app.sh",
    "app:build:fast": "bash scripts/build-app.sh --fast",
    "app:build:verify": "bash scripts/build-app.sh --verify",
    "app:build:notarize": "bash scripts/build-app.sh --notarize",
    "app:build:ship": "bash scripts/build-app.sh --verify --notarize",
    "app:notarize": "bash scripts/notarize-app.sh",
    "app:install": "bash scripts/install-app.sh",
    "app:install:fast": "bash scripts/install-app.sh --fast",
    "app:install:skip-build": "bash scripts/install-app.sh --skip-build",
    "app:install:supervised": "bash scripts/install-app.sh --supervised",
    "app:open": "open \"/Applications/Vellum Command.app\"",
    "app:uninstall-agent": "bash scripts/install-launchd.sh --uninstall",
    "digest": "bun scripts/digest.ts",
    "canvas:ls": "bun scripts/canvas-ls.ts",
    "canvas:rm": "bun scripts/canvas-rm.ts",
    "ref": "bun scripts/ref-cli.ts",
    "browser": "bun scripts/browser-cli.ts",
    "render": "bun scripts/render.ts",
    "cli": "bun src/cli/main.ts",
    "cli:build": "bun build --compile --outfile dist/vellum src/cli/main.ts"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "@effect/platform-node": "^0.106.0",
    "@legendapp/state": "^3.0.0-beta.31",
    "@pierre/diffs": "^1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "effect": "^3.21.1",
    "gradient-spin": "^0.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "43.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "react-doctor": "^0.9.0",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "skastr0.vellum",
    "productName": "Vellum Command",
    "afterPack": "./scripts/electron-builder-after-pack.mjs",
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
    "files": [
      "out/**",
      "station/**",
      "package.json",
      "!node_modules/@parcel/watcher{,/**/*}",
      "!node_modules/@parcel/watcher-*{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "dist/vellum-browser",
        "to": "bin/vellum-browser"
      },
      {
        "from": "scripts/unix-peer-pid.py",
        "to": "bin/unix-peer-pid.py"
      }
    ],
    "protocols": [
      {
        "name": "Vellum Command node reference",
        "schemes": ["vellum"],
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "Example Maintainer (EXAMP12345)",
      "hardenedRuntime": true,
      "strictVerify": true,
      "sign": "./scripts/electron-builder-sign.mjs",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "preAutoEntitlements": false
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "iconSize": 128,
      "title": "Vellum Command ${version}",
      "contents": [
        {
          "x": 360,
          "y": 360,
          "type": "file"
        },
        {
          "x": 920,
          "y": 360,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 1280,
        "height": 720
      }
    }
  }
}
