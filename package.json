{
  "name": "@skastr0/vellum",
  "version": "0.1.0",
  "description": "Desktop station for the portfolio canvas: JSON Canvas + ether extension over tower, quasar, and booth.",
  "type": "module",
  "private": true,
  "trustedDependencies": ["electron"],
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bash scripts/build-app.sh --fast",
    "build:pack": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && electron-vite build",
    "app:build": "bash scripts/build-app.sh",
    "app:build:fast": "bash scripts/build-app.sh --fast",
    "app:build:verify": "bash scripts/build-app.sh --verify",
    "app:install": "bash scripts/install-app.sh",
    "app:install:fast": "bash scripts/install-app.sh --fast",
    "app:install:skip-build": "bash scripts/install-app.sh --skip-build",
    "app:install:supervised": "bash scripts/install-app.sh --supervised",
    "app:open": "open /Applications/Vellum.app",
    "app:uninstall-agent": "bash scripts/install-launchd.sh --uninstall",
    "digest": "bun scripts/digest.ts",
    "canvas:ls": "bun scripts/canvas-ls.ts",
    "canvas:rm": "bun scripts/canvas-rm.ts",
    "browser": "bun scripts/browser-cli.ts",
    "populate": "bun scripts/populate.ts",
    "render": "bun scripts/render.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.96.0",
    "@legendapp/state": "^3.0.0-beta.31",
    "@pierre/diffs": "^1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@skastr0/booth-sdk": "file:../booth-cli/packages/booth-sdk",
    "@skastr0/quasar-sdk": "file:../quasar/packages/sdk",
    "@skastr0/tower-sdk": "file:../tower-cli/packages/tower-sdk",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "effect": "^3.21.1",
    "gradient-spin": "^0.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "skastr0.vellum",
    "productName": "Vellum",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "station/**",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    }
  }
}
