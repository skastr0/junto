{
  "name": "@skastr0/vellum",
  "version": "0.1.14",
  "description": "Vellum Command \u2014 the deep-field station for multi-agent fleets.",
  "author": {
    "name": "Guilherme Castro",
    "email": "skastr052@gmail.com"
  },
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/vellum.git"
  },
  "bugs": {
    "url": "https://github.com/skastr0/vellum/issues"
  },
  "homepage": "https://github.com/skastr0/vellum#readme",
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "postinstall": "bun scripts/ensure-node-pty-perms.ts",
    "dev": "bash scripts/dev.sh",
    "dev:license": "bash scripts/dev-license.sh",
    "license:status": "bun scripts/license-state.ts status",
    "license:backup": "bun scripts/license-state.ts backup",
    "license:clear": "bun scripts/license-state.ts clear --yes",
    "license:restore": "bun scripts/license-state.ts restore --yes",
    "build": "bash scripts/build-app.sh --fast",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "theme:build": "bun scripts/theme-build.ts",
    "schema:identity": "bun scripts/schema-identity.ts",
    "lint:product-name": "bun scripts/lint-product-name.ts",
    "lint:no-middot": "bun scripts/lint-no-middot.ts",
    "lint:effect-runpromise": "bun scripts/lint-effect-runpromise.ts",
    "lint:single-write-seam": "bun scripts/lint-single-write-seam.ts",
    "test": "VELLUM_COMMAND_TEST_FEATURE_PROFILE=all-on vitest run",
    "test:features:ship": "VELLUM_COMMAND_TEST_FEATURE_PROFILE=ship vitest run tests/features-build-profile.test.ts tests/features-*-gate.test.ts",
    "test:features:all-on": "VELLUM_COMMAND_TEST_FEATURE_PROFILE=all-on vitest run",
    "test:sqlite:electron": "ELECTRON_RUN_AS_NODE=1 electron scripts/electron-sqlite-smoke.mjs",
    "doctor": "react-doctor --no-telemetry src/renderer",
    "test:e2e": "VELLUM_COMMAND_FEATURE_PROFILE=all-on electron-vite build && playwright test --config e2e/playwright.config.ts",
    "pty:verify": "bun scripts/pty-verify.ts",
    "test:e2e:fast": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:perf": "VELLUM_COMMAND_FEATURE_PROFILE=all-on electron-vite build && playwright test --config e2e/playwright.config.ts e2e/scenarios/canvas-interaction-perf.spec.ts",
    "test:browser:electron": "bun scripts/browser-electron-containment-probe.ts",
    "test:browser:crash-recovery": "bun scripts/browser-electron-renderer-crash-recovery-probe.ts",
    "test:browser:profile-wipe": "bun scripts/browser-electron-profile-wipe-probe.ts",
    "verify": "bun run lint:product-name && bun run lint:no-middot && bun run lint:effect-runpromise && bun run lint:single-write-seam && bun run typecheck && bun run test && bun run test:features:ship && electron-vite build",
    "app:build": "bash scripts/build-app.sh",
    "app:build:mac": "bash scripts/build-app.sh --target mac",
    "app:build:linux": "bash scripts/build-app.sh --target linux",
    "app:build:fast": "bash scripts/build-app.sh --fast",
    "app:build:verify": "bash scripts/build-app.sh --verify",
    "app:build:notarize": "bash scripts/build-app.sh --notarize",
    "app:build:ship": "bash scripts/build-app.sh --verify --notarize",
    "version:bump": "bun scripts/bump-version.ts",
    "mac:release:publish": "bun scripts/publish-mac-release.ts",
    "linux:release:evidence": "bun scripts/linux-release-inventory.ts",
    "linux:release:create": "bun scripts/linux-release-tool.ts create",
    "linux:release:sign": "bun scripts/linux-release-tool.ts sign",
    "linux:release:verify": "bun scripts/linux-release-verify.ts",
    "linux:release:verify:build": "bun build --compile --outfile dist/vellum-command-linux-verify-x64 scripts/linux-release-verify.ts",
    "linux:release:archive": "bun scripts/linux-release-archive.ts create",
    "linux:qualify:orbstack": "bun scripts/linux-orbstack-two-station-qualification.ts",
    "app:notarize": "bash scripts/notarize-app.sh",
    "app:install": "bash scripts/install-app.sh",
    "app:install:fast": "bash scripts/install-app.sh --fast",
    "app:install:skip-build": "bash scripts/install-app.sh --skip-build",
    "app:install:supervised": "bash scripts/install-app.sh --supervised",
    "app:open": "open \"/Applications/Vellum Command.app\"",
    "app:uninstall-agent": "bash scripts/install-launchd.sh --uninstall",
    "host:ops": "bun scripts/host-ops.ts",
    "logs:transport": "bun scripts/transport-logs.ts",
    "digest": "bun scripts/digest.ts",
    "canvas:ls": "bun scripts/canvas-ls.ts",
    "ref": "bun scripts/ref-cli.ts",
    "browser": "bun src/cli/main.ts browser",
    "station": "bun src/cli/main.ts station-stdio",
    "content-transfer": "bun src/cli/main.ts content-transfer",
    "render": "bun scripts/render.ts",
    "cli": "bun src/cli/main.ts",
    "cli:build": "bun scripts/build-standalone-cli.ts vellum-command",
    "cli:build:dev": "bun scripts/build-standalone-cli.ts vellum-command-dev",
    "remote:build": "bun scripts/build-vellum-remote.ts",
    "package:qualify:runtime-parity": "bun scripts/qualify-package-runtime-parity.ts",
    "plugin:precompile": "bun scripts/precompile-vellum-plugin.ts"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@legendapp/state": "^3.0.0-beta.31",
    "@pierre/diffs": "^1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "0.20.0-beta.298",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.1.0-beta.302",
    "@xyflow/react": "^12.11.2",
    "effect": "4.0.0-rc.112",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "thinking-orbs": "0.1.1",
    "three": "^0.185.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "1.61.1",
    "@skastr0/prism-packager": "0.4.4",
    "@tailwindcss/vite": "^4.1.17",
    "@types/bun": "1.3.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "react-doctor": "^0.9.0",
    "react-scan": "^0.5.7",
    "spdx-expression-parse": "^5.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "skastr0.vellumcommand",
    "productName": "Vellum Command",
    "afterPack": "./scripts/electron-builder-after-pack.mjs",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/build/Release/{pty.node,spawn-helper}",
      "node_modules/node-pty/prebuilds/${os}-${arch}/{pty.node,spawn-helper}"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Vellum-Command-${version}-${arch}-mac.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://vellumreleasedistribution-rele2p3h3apcupwjim2zajqqmhyd.skastr052.workers.dev/mac/arm64"
      }
    ],
    "files": [
      "out/**",
      "!out/remote{,/**/*}",
      "station/**",
      "package.json",
      "!node_modules/@parcel/watcher{,/**/*}",
      "!node_modules/@parcel/watcher-*{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "dist/vellum-command",
        "to": "bin/vellum-command"
      },
      {
        "from": "scripts/unix-peer-pid.py",
        "to": "bin/unix-peer-pid.py"
      }
    ],
    "protocols": [
      {
        "name": "Vellum Command node reference",
        "schemes": [
          "vellum-command"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "artifactName": "Vellum-Command-${version}-${arch}-mac.${ext}",
      "forceCodeSigning": true,
      "target": [
        "zip",
        "dmg"
      ],
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "Example Maintainer (EXAMP12345)",
      "hardenedRuntime": true,
      "strictVerify": true,
      "sign": "./scripts/electron-builder-sign.mjs",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "preAutoEntitlements": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "executableName": "vellum-command",
      "category": "Development",
      "synopsis": "Spatial command station for multi-agent fleets",
      "icon": "assets/brand/vellum-command-icon.png",
      "files": [
        "out/**",
        "!out/remote{,/**/*}",
        "station/**",
        "package.json",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-*/**",
        "!node_modules/@msgpackr-extract/msgpackr-extract-linux-x64/*.musl.node"
      ],
      "extraResources": [
        {
          "from": "build/linux/vellum-remote-launch",
          "to": "systemd/vellum-command-remote-launch"
        },
        {
          "from": "build/linux/vellum-remote.service.template",
          "to": "systemd/vellum-command-remote.service.template"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Vellum Command",
          "Comment": "Spatial command station for multi-agent fleets"
        }
      }
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "iconSize": 128,
      "title": "Vellum Command ${version}",
      "contents": [
        {
          "x": 360,
          "y": 360,
          "type": "file"
        },
        {
          "x": 920,
          "y": 360,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 1280,
        "height": 720
      }
    }
  }
}
