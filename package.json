{
  "name": "@skastr0/vellum",
  "version": "0.1.0",
  "description": "Vellum Command — the deep-field station for multi-agent fleets.",
  "author": {
    "name": "Guilherme Castro",
    "email": "skastr052@gmail.com"
  },
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/vellum.git"
  },
  "bugs": {
    "url": "https://github.com/skastr0/vellum/issues"
  },
  "homepage": "https://github.com/skastr0/vellum#readme",
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "postinstall": "bun scripts/ensure-node-pty-perms.ts",
    "dev": "electron-vite dev",
    "build": "bash scripts/build-app.sh --fast",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sqlite:electron": "ELECTRON_RUN_AS_NODE=1 electron scripts/electron-sqlite-smoke.mjs",
    "doctor": "react-doctor --no-telemetry src/renderer",
    "test:e2e": "electron-vite build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:fast": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:perf": "electron-vite build && playwright test --config e2e/playwright.config.ts e2e/scenarios/canvas-interaction-perf.spec.ts",
    "test:browser:electron": "bun scripts/browser-electron-containment-probe.ts",
    "test:browser:crash-recovery": "bun scripts/browser-electron-renderer-crash-recovery-probe.ts",
    "test:browser:profile-wipe": "bun scripts/browser-electron-profile-wipe-probe.ts",
    "verify": "bun scripts/electron-security-policy.ts validate && bun run typecheck && bun run test && electron-vite build",
    "electron:policy:validate": "bun scripts/electron-security-policy.ts validate",
    "electron:policy:check": "bun scripts/electron-security-policy.ts check",
    "app:build": "bash scripts/build-app.sh",
    "app:build:beta": "bash scripts/build-app.sh --channel beta",
    "app:build:production": "bash scripts/build-app.sh --channel production",
    "app:build:mac": "bash scripts/build-app.sh --target mac",
    "app:build:linux": "bash scripts/build-app.sh --target linux",
    "app:build:fast": "bash scripts/build-app.sh --fast",
    "app:build:verify": "bash scripts/build-app.sh --verify",
    "app:build:notarize": "bash scripts/build-app.sh --notarize",
    "app:build:ship": "bash scripts/build-app.sh --verify --notarize",
    "app:build:beta:ship": "bash scripts/build-app.sh --channel beta --verify --notarize",
    "app:build:production:ship": "bash scripts/build-app.sh --channel production --verify --notarize",
    "linux:release:evidence": "bun scripts/linux-release-inventory.ts",
    "linux:release:create": "bun scripts/linux-release-tool.ts create",
    "linux:release:sign": "bun scripts/linux-release-tool.ts sign",
    "linux:release:verify": "bun scripts/linux-release-verify.ts",
    "linux:release:verify:build": "bun build --compile --outfile dist/vellum-linux-verify-x64 scripts/linux-release-verify.ts",
    "app:notarize": "bash scripts/notarize-app.sh",
    "app:install": "bash scripts/install-app.sh",
    "app:install:fast": "bash scripts/install-app.sh --fast",
    "app:install:skip-build": "bash scripts/install-app.sh --skip-build",
    "app:install:supervised": "bash scripts/install-app.sh --supervised",
    "app:open": "open \"/Applications/Vellum Command.app\"",
    "app:uninstall-agent": "bash scripts/install-launchd.sh --uninstall",
    "digest": "bun scripts/digest.ts",
    "canvas:ls": "bun scripts/canvas-ls.ts",
    "ref": "bun scripts/ref-cli.ts",
    "browser": "bun scripts/browser-cli.ts",
    "station": "bun scripts/station-cli.ts",
    "render": "bun scripts/render.ts",
    "cli": "bun src/cli/main.ts",
    "cli:build": "bun build --compile --outfile dist/vellum src/cli/main.ts",
    "station:build": "bun build --compile --outfile dist/vellum-station scripts/station-cli.ts",
    "plugin:precompile": "bun scripts/precompile-vellum-plugin.ts"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "@effect/platform-node": "^0.106.0",
    "@legendapp/state": "^3.0.0-beta.31",
    "@pierre/diffs": "^1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "effect": "^3.21.1",
    "gradient-spin": "^0.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "thinking-orbs": "0.1.1",
    "three": "^0.185.1",
    "ulid": "^3.0.2",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/bun": "1.3.13",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.61.1",
    "react-doctor": "^0.9.0",
    "react-scan": "^0.5.7",
    "spdx-expression-parse": "^5.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15",
    "@skastr0/prism-packager": "0.4.4"
  },
  "build": {
    "appId": "skastr0.vellum",
    "productName": "Vellum Command",
    "afterPack": "./scripts/electron-builder-after-pack.mjs",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/build/Release/{pty.node,spawn-helper}",
      "node_modules/node-pty/prebuilds/${os}-${arch}/{pty.node,spawn-helper}"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Vellum-Command-${version}-${arch}-mac.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://releases.vellumcommand.com/mac/arm64"
      }
    ],
    "files": [
      "out/**",
      "station/**",
      "package.json",
      "!node_modules/@parcel/watcher{,/**/*}",
      "!node_modules/@parcel/watcher-*{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "dist/vellum",
        "to": "bin/vellum"
      },
      {
        "from": "dist/vellum-browser",
        "to": "bin/vellum-browser"
      },
      {
        "from": "dist/vellum-station",
        "to": "bin/vellum-station"
      },
      {
        "from": "scripts/unix-peer-pid.py",
        "to": "bin/unix-peer-pid.py"
      },
      {
        "from": "scripts/electron-security-policy.json",
        "to": "policy/electron-security-policy.json"
      },
      {
        "from": "build/electron-observation.json",
        "to": "policy/electron-observation.json"
      },
      {
        "from": "build/electron-observation-high-water.json",
        "to": "policy/electron-observation-high-water.json"
      }
    ],
    "protocols": [
      {
        "name": "Vellum Command node reference",
        "schemes": [
          "vellum"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "artifactName": "Vellum-Command-${version}-${arch}-mac.${ext}",
      "forceCodeSigning": true,
      "target": [
        "zip",
        "dmg"
      ],
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "Example Maintainer (EXAMP12345)",
      "hardenedRuntime": true,
      "strictVerify": true,
      "sign": "./scripts/electron-builder-sign.mjs",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "preAutoEntitlements": false
    },
    "linux": {
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "target": [
        "dir",
        "deb"
      ],
      "executableName": "vellum",
      "category": "Development",
      "synopsis": "Spatial command station for multi-agent fleets",
      "icon": "assets/brand/vellum-command-icon.png",
      "files": [
        "out/**",
        "station/**",
        "package.json",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-*/**"
      ],
      "extraResources": [
        {
          "from": "build/linux/apparmor-profile",
          "to": "apparmor-profile"
        },
        {
          "from": "build/linux/vellum-remote-launch-v1",
          "to": "systemd/vellum-remote-launch-v1"
        },
        {
          "from": "build/linux/vellum-remote.service",
          "to": "systemd/vellum-remote.service"
        },
        {
          "from": "dist/vellum-release-installer",
          "to": "bin/vellum-release-installer"
        },
        {
          "from": "dist/vellum-release-bridge",
          "to": "bin/vellum-release-bridge"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Vellum Command",
          "Comment": "Spatial command station for multi-agent fleets"
        }
      }
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "packageName": "vellum",
      "maintainer": "Guilherme Castro <skastr052@gmail.com>",
      "vendor": "Vellum",
      "packageCategory": "devel",
      "priority": "optional",
      "compression": "xz",
      "depends": [
        "apparmor",
        "libasound2t64",
        "libatspi2.0-0t64",
        "libdrm2",
        "libgbm1",
        "libgtk-3-0t64",
        "libnotify4",
        "libnspr4",
        "libnss3",
        "libsecret-1-0",
        "libuuid1",
        "libx11-6",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxkbcommon0",
        "libxrandr2",
        "libxss1",
        "libxtst6",
        "openssh-client",
        "procps",
        "python3",
        "sudo",
        "xauth",
        "xdg-utils",
        "xvfb"
      ],
      "recommends": [],
      "fpm": [
        "--before-install=build/linux/before-install.sh",
        "--before-remove=build/linux/before-remove.sh",
        "--deb-user=root",
        "--deb-group=root"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "appArmorProfile": "build/linux/apparmor-profile"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "iconSize": 128,
      "title": "Vellum Command ${version}",
      "contents": [
        {
          "x": 360,
          "y": 360,
          "type": "file"
        },
        {
          "x": 920,
          "y": 360,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 1280,
        "height": 720
      }
    }
  }
}
