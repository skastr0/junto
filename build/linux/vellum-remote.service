[Unit]
Description=Vellum Remote headless station
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=3
ConditionFileIsExecutable=/opt/Vellum Command/vellum

[Service]
Type=notify
# The launcher authenticates its child readiness receipt and asks
# systemd-notify to identify that launcher's parent (the unit MainPID).
NotifyAccess=main
ExecStart=/opt/Vellum\x20Command/resources/systemd/vellum-remote-launch-v1
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
Environment=PATH=/usr/bin:/bin
Environment=HOME=%h
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_RUNTIME_DIR=%t
RuntimeDirectory=vellum-remote
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=ELECTRON_OZONE_PLATFORM_HINT=x11
Environment=OZONE_PLATFORM=x11
Environment=XDG_SESSION_TYPE=x11
StandardOutput=null
StandardError=null
SyslogIdentifier=vellum-remote

[Install]
WantedBy=default.target
