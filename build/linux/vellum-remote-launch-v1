#!/bin/sh
# Versioned, package-owned headless Remote launcher. This is deliberately a
# fixed invocation: station role and host identity remain the user's state.
set -eu

PATH='/usr/bin:/bin'
export PATH
umask 077

APP_DIR='/opt/Vellum Command'
VELLUM="$APP_DIR/vellum"
XVFB='/usr/bin/Xvfb'
XAUTH='/usr/bin/xauth'
SETSID='/usr/bin/setsid'
SYSTEMD_NOTIFY='/usr/bin/systemd-notify'
DISPLAY_NUMBER='89'
DISPLAY=":$DISPLAY_NUMBER"
LOCK_FILE="/tmp/.X${DISPLAY_NUMBER}-lock"
SOCKET_FILE="/tmp/.X11-unix/X${DISPLAY_NUMBER}"
RUNTIME_HOME="${HOME:?vellum-remote-launch-v1 requires HOME}"
RUNTIME_DIRECTORY="${XDG_RUNTIME_DIR:?vellum-remote-launch-v1 requires XDG_RUNTIME_DIR}"
AUTHORITY_DIRECTORY="$RUNTIME_DIRECTORY/vellum-remote-x11"
XAUTHORITY="$AUTHORITY_DIRECTORY/authority"

case "$RUNTIME_HOME" in
  /*) ;;
  *) printf '%s\n' 'vellum-remote: HOME must be absolute' >&2; exit 64 ;;
esac

if [ ! -x "$VELLUM" ] || [ ! -x "$XVFB" ] || [ ! -x "$XAUTH" ] || \
   [ ! -x "$SETSID" ] || [ ! -x "$SYSTEMD_NOTIFY" ]; then
  printf '%s\n' 'vellum-remote: packaged runtime is unavailable' >&2
  exit 69
fi

ensure_owned_directory() {
  directory="$1"
  if [ -L "$directory" ]; then
    printf '%s\n' 'vellum-remote: refusing managed directory symlink' >&2
    exit 73
  fi
  if [ -e "$directory" ]; then
    if [ ! -d "$directory" ] || [ ! -O "$directory" ] || \
       [ "$(/usr/bin/stat -c '%a' "$directory" 2>/dev/null || true)" != '700' ]; then
      printf '%s\n' 'vellum-remote: refusing unmanaged directory' >&2
      exit 73
    fi
    return
  fi
  mkdir -m 0700 -- "$directory"
}

if [ ! -d "$RUNTIME_HOME" ] || [ -L "$RUNTIME_HOME" ] || [ ! -O "$RUNTIME_HOME" ]; then
  printf '%s\n' 'vellum-remote: HOME must be an owned non-symlink directory' >&2
  exit 73
fi
ensure_owned_directory "$RUNTIME_HOME/.vellum"
ensure_owned_directory "$RUNTIME_HOME/.local"
ensure_owned_directory "$RUNTIME_HOME/.local/state"

# Shell cannot bind a stat to a later unlink. Any X lock is therefore an
# operator-visible conflict, never a stale-cleanup target.
if [ -e "$LOCK_FILE" ] || [ -L "$LOCK_FILE" ]; then
  printf '%s\n' 'vellum-remote: managed display lock is already in use' >&2
  exit 75
fi
if [ -e "$SOCKET_FILE" ] || [ -L "$SOCKET_FILE" ]; then
  printf '%s\n' 'vellum-remote: managed display socket is already in use' >&2
  exit 75
fi

export DISPLAY
export XAUTHORITY
export ELECTRON_OZONE_PLATFORM_HINT='x11'
export OZONE_PLATFORM='x11'
export XDG_SESSION_TYPE='x11'
export XDG_STATE_HOME="$RUNTIME_HOME/.local/state"

owned_child_alive() {
  if ! kill -0 "$1" 2>/dev/null; then
    return 1
  fi
  child_state="$(/usr/bin/ps -o stat= -p "$1" 2>/dev/null | /usr/bin/tr -d ' ')"
  case "$child_state" in
    Z*|'') return 1 ;;
    *) return 0 ;;
  esac
}

xvfb_pid=''
vellum_pid=''
authority_directory_owned=0
cleanup_owned_resources() {
  if [ -n "$vellum_pid" ]; then
    kill -TERM -- "-$vellum_pid" 2>/dev/null || true
    if ! wait_bounded_group "$vellum_pid"; then
      kill -KILL -- "-$vellum_pid" 2>/dev/null || true
    fi
    wait "$vellum_pid" 2>/dev/null || true
    vellum_pid=''
  fi
  if [ -n "$xvfb_pid" ]; then
    kill -TERM "$xvfb_pid" 2>/dev/null || true
    if ! wait_bounded_child "$xvfb_pid"; then
      kill -KILL "$xvfb_pid" 2>/dev/null || true
    fi
    wait "$xvfb_pid" 2>/dev/null || true
    xvfb_pid=''
  fi
  # Do not unlink Xauthority after a check: POSIX shell has no descriptor-bound
  # unlink. A replacement remains in the private directory for inspection.
  if [ "$authority_directory_owned" -eq 1 ]; then
    rmdir "$AUTHORITY_DIRECTORY" 2>/dev/null || true
  fi
}

wait_bounded_child() {
  child="$1"
  deadline=$(( $(date +%s) + 5 ))
  while owned_child_alive "$child"; do
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 1
  done
  return 0
}

wait_bounded_group() {
  # The setsid leader is the capability for this exact group; never accept a
  # pid supplied by the environment or a system manager as signal authority.
  wait_bounded_child "$1"
}

if [ -e "$AUTHORITY_DIRECTORY" ] || [ -L "$AUTHORITY_DIRECTORY" ]; then
  printf '%s\n' 'vellum-remote: managed X11 authority is already in use' >&2
  exit 75
fi
mkdir -m 0700 -- "$AUTHORITY_DIRECTORY"
authority_directory_owned=1
set -C
if ! : > "$XAUTHORITY"; then
  set +C
  printf '%s\n' 'vellum-remote: could not create managed X11 authority' >&2
  rmdir "$AUTHORITY_DIRECTORY" 2>/dev/null || true
  exit 73
fi
set +C
trap cleanup_owned_resources EXIT
trap 'cleanup_owned_resources; exit 129' HUP
trap 'cleanup_owned_resources; exit 130' INT
trap 'cleanup_owned_resources; exit 143' TERM
if ! "$XAUTH" -f "$XAUTHORITY" add "$DISPLAY" . "$(/usr/bin/mcookie)" >/dev/null 2>&1; then
  printf '%s\n' 'vellum-remote: could not initialize managed X11 authority' >&2
  exit 70
fi
if [ ! -f "$XAUTHORITY" ] || [ -L "$XAUTHORITY" ] || [ ! -O "$XAUTHORITY" ] || \
   [ "$(/usr/bin/stat -c '%a' "$XAUTHORITY" 2>/dev/null || true)" != '600' ]; then
  printf '%s\n' 'vellum-remote: managed X11 authority changed during initialization' >&2
  exit 73
fi

"$XVFB" "$DISPLAY" -screen 0 1280x1024x24 -nolisten tcp -auth "$XAUTHORITY" &
xvfb_pid="$!"

ready_deadline=$(( $(date +%s) + 10 ))
while [ ! -S "$SOCKET_FILE" ]; do
  if ! owned_child_alive "$xvfb_pid"; then
    printf '%s\n' 'vellum-remote: managed display failed to start' >&2
    exit 70
  fi
  if [ "$(date +%s)" -ge "$ready_deadline" ]; then
    printf '%s\n' 'vellum-remote: managed display start timed out' >&2
    exit 70
  fi
  sleep 1
done

"$SETSID" "$VELLUM" --vellum-headless --ozone-platform=x11 &
vellum_pid="$!"
ready_deadline=$(( $(date +%s) + 30 ))
while [ ! -S "$RUNTIME_HOME/.vellum/work/control.sock" ] || \
      [ ! -r "$RUNTIME_HOME/.vellum/work/token" ]; do
  if ! owned_child_alive "$vellum_pid"; then
    set +e
    wait "$vellum_pid"
    vellum_status="$?"
    set -e
    vellum_pid=''
    exit "$vellum_status"
  fi
  if [ "$(date +%s)" -ge "$ready_deadline" ]; then
    printf '%s\n' 'vellum-remote: product control plane did not become ready' >&2
    exit 70
  fi
  sleep 1
done
"$SYSTEMD_NOTIFY" --ready --status='Vellum work control ready'
while :; do
  if ! owned_child_alive "$xvfb_pid"; then
    kill -TERM -- "-$vellum_pid" 2>/dev/null || true
    if ! wait_bounded_group "$vellum_pid"; then
      kill -KILL -- "-$vellum_pid" 2>/dev/null || true
    fi
    set +e
    wait "$vellum_pid"
    set -e
    vellum_pid=''
    exit 70
  fi
  if ! owned_child_alive "$vellum_pid"; then
    set +e
    wait "$vellum_pid"
    vellum_status="$?"
    set -e
    vellum_pid=''
    exit "$vellum_status"
  fi
  sleep 1
done
