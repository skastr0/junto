#!/bin/sh
# Versioned, package-owned headless Remote launcher. This is deliberately a
# fixed invocation: station role and host identity remain the user's state.

CLEAN_SELF='/opt/Vellum Command/resources/systemd/vellum-remote-launch-v1'
if [ "$#" -eq 0 ]; then
  CLEAN_HOME="${HOME:?vellum-remote-launch-v1 requires HOME}"
  CLEAN_STATE_HOME="${XDG_STATE_HOME:?vellum-remote-launch-v1 requires XDG_STATE_HOME}"
  CLEAN_RUNTIME_DIRECTORY="${XDG_RUNTIME_DIR:?vellum-remote-launch-v1 requires XDG_RUNTIME_DIR}"
  CLEAN_GENERATION="${INVOCATION_ID:?vellum-remote-launch-v1 requires INVOCATION_ID}"
  CLEAN_NOTIFY_SOCKET="${NOTIFY_SOCKET:?vellum-remote-launch-v1 requires NOTIFY_SOCKET}"
  if [ "$CLEAN_NOTIFY_SOCKET" != "$CLEAN_RUNTIME_DIRECTORY/systemd/notify" ]; then
    printf '%s\n' 'vellum-remote: unexpected systemd notification socket' >&2
    exit 64
  fi
  exec /usr/bin/env -i \
    PATH='/usr/bin:/bin' \
    HOME="$CLEAN_HOME" \
    PWD="$CLEAN_HOME" \
    XDG_STATE_HOME="$CLEAN_STATE_HOME" \
    XDG_RUNTIME_DIR="$CLEAN_RUNTIME_DIRECTORY" \
    INVOCATION_ID="$CLEAN_GENERATION" \
    ELECTRON_OZONE_PLATFORM_HINT='x11' \
    OZONE_PLATFORM='x11' \
    XDG_SESSION_TYPE='x11' \
    "$CLEAN_SELF" --clean
  exit 69
fi
if [ "$#" -ne 1 ] || [ "$1" != '--clean' ]; then
  printf '%s\n' 'vellum-remote: clean launcher sentinel is required' >&2
  exit 64
fi

set -eu

PATH='/usr/bin:/bin'
export PATH
umask 077

APP_DIR='/opt/Vellum Command'
VELLUM="$APP_DIR/vellum"
XVFB='/usr/bin/Xvfb'
XAUTH='/usr/bin/xauth'
SETSID='/usr/bin/setsid'
SYSTEMD_NOTIFY='/usr/bin/systemd-notify'
DISPLAY_FIRST=89
DISPLAY_LAST=96
RUNTIME_HOME="${HOME:?vellum-remote-launch-v1 requires HOME}"
RUNTIME_DIRECTORY="${XDG_RUNTIME_DIR:?vellum-remote-launch-v1 requires XDG_RUNTIME_DIR}"
SYSTEMD_NOTIFY_SOCKET="$RUNTIME_DIRECTORY/systemd/notify"
SERVICE_RUNTIME_DIRECTORY="$RUNTIME_DIRECTORY/vellum-remote"
GENERATION="${INVOCATION_ID:?vellum-remote-launch-v1 requires INVOCATION_ID}"

case "$RUNTIME_HOME" in
  /*) ;;
  *) printf '%s\n' 'vellum-remote: HOME must be absolute' >&2; exit 64 ;;
esac
case "$GENERATION" in
  *[!0-9a-f]*)
    printf '%s\n' 'vellum-remote: INVOCATION_ID must be 32 lowercase hexadecimal characters' >&2
    exit 64
    ;;
esac
case "$SYSTEMD_NOTIFY_SOCKET" in
  /*) ;;
  *) printf '%s\n' 'vellum-remote: NOTIFY_SOCKET must be absolute' >&2; exit 64 ;;
esac
# The readiness capability belongs only to the wrapper. The inherited socket
# was validated and erased by env -i; only the exact notifier receives it.
if [ "${#GENERATION}" -ne 32 ]; then
  printf '%s\n' 'vellum-remote: INVOCATION_ID must be 32 lowercase hexadecimal characters' >&2
  exit 64
fi

if [ ! -x "$VELLUM" ] || [ ! -x "$XVFB" ] || [ ! -x "$XAUTH" ] || \
   [ ! -x "$SETSID" ] || [ ! -x "$SYSTEMD_NOTIFY" ]; then
  printf '%s\n' 'vellum-remote: packaged runtime is unavailable' >&2
  exit 69
fi

ensure_owned_directory() {
  directory="$1"
  kind="$2"
  if [ -L "$directory" ]; then
    printf '%s\n' 'vellum-remote: refusing managed directory symlink' >&2
    exit 73
  fi
  if [ -e "$directory" ]; then
    mode="$(/usr/bin/stat -c '%a' "$directory" 2>/dev/null || true)"
    if [ ! -d "$directory" ] || [ ! -O "$directory" ] || \
       { [ "$kind" = private ] && [ "$mode" != 700 ]; } || \
       { [ "$kind" = parent ] && [ "$mode" != 700 ] && [ "$mode" != 755 ]; }; then
      printf '%s\n' 'vellum-remote: refusing unmanaged directory' >&2
      exit 73
    fi
    return
  fi
  if [ "$kind" = private ]; then mkdir -m 700 -- "$directory"; else mkdir -m 755 -- "$directory"; fi
}

file_identity() {
  path="$1"
  if [ -L "$path" ]; then
    printf '%s\n' 'symlink'
  elif [ -e "$path" ]; then
    /usr/bin/stat -c '%d:%i' -- "$path" 2>/dev/null || printf '%s\n' 'unreadable'
  else
    printf '%s\n' 'missing'
  fi
}

is_owned_private_socket() {
  path="$1"
  [ -S "$path" ] && [ ! -L "$path" ] && [ -O "$path" ] && \
    [ "$(/usr/bin/stat -c '%a' "$path" 2>/dev/null || true)" = 600 ]
}

is_owned_private_file() {
  path="$1"
  [ -f "$path" ] && [ ! -L "$path" ] && [ -O "$path" ] && \
    [ "$(/usr/bin/stat -c '%a' "$path" 2>/dev/null || true)" = 600 ]
}

if [ ! -d "$RUNTIME_HOME" ] || [ -L "$RUNTIME_HOME" ] || [ ! -O "$RUNTIME_HOME" ]; then
  printf '%s\n' 'vellum-remote: HOME must be an owned non-symlink directory' >&2
  exit 73
fi
ensure_owned_directory "$RUNTIME_HOME/.vellum" private
# .local is a normal XDG parent, not a Vellum-private leaf.
ensure_owned_directory "$RUNTIME_HOME/.local" parent
ensure_owned_directory "$RUNTIME_HOME/.local/state" parent
if [ ! -d "$SERVICE_RUNTIME_DIRECTORY" ] || [ -L "$SERVICE_RUNTIME_DIRECTORY" ] || \
   [ ! -O "$SERVICE_RUNTIME_DIRECTORY" ] || \
   [ "$(/usr/bin/stat -c '%a' "$SERVICE_RUNTIME_DIRECTORY" 2>/dev/null || true)" != '700' ]; then
  printf '%s\n' 'vellum-remote: systemd runtime directory is unavailable' >&2
  exit 73
fi

display_number=''
for candidate in $(/usr/bin/seq "$DISPLAY_FIRST" "$DISPLAY_LAST"); do
  candidate_lock="/tmp/.X${candidate}-lock"
  candidate_socket="/tmp/.X11-unix/X${candidate}"
  if [ ! -e "$candidate_lock" ] && [ ! -L "$candidate_lock" ] && \
     [ ! -e "$candidate_socket" ] && [ ! -L "$candidate_socket" ]; then
    display_number="$candidate"
    break
  fi
done
if [ -z "$display_number" ]; then
  printf '%s\n' 'vellum-remote: no managed display is available' >&2
  exit 75
fi
DISPLAY=":$display_number"
SOCKET_FILE="/tmp/.X11-unix/X${display_number}"
# RuntimeDirectory is systemd-owned and removed when this unit stops. A unique
# child prevents an interrupted generation from becoming a later authority.
AUTHORITY_DIRECTORY="$SERVICE_RUNTIME_DIRECTORY/x11-$GENERATION"
XAUTHORITY="$AUTHORITY_DIRECTORY/authority"
READY_RECEIPT="$SERVICE_RUNTIME_DIRECTORY/ready-$GENERATION"

export DISPLAY
export XAUTHORITY
export ELECTRON_OZONE_PLATFORM_HINT='x11'
export OZONE_PLATFORM='x11'
export XDG_SESSION_TYPE='x11'
export XDG_STATE_HOME="$RUNTIME_HOME/.local/state"

owned_child_alive() {
  if ! kill -0 "$1" 2>/dev/null; then
    return 1
  fi
  child_state="$(/usr/bin/ps -o stat= -p "$1" 2>/dev/null | /usr/bin/tr -d ' ')"
  case "$child_state" in
    Z*|'') return 1 ;;
    *) return 0 ;;
  esac
}

xvfb_pid=''
vellum_pid=''
vellum_group=''
is_positive_pid() {
  case "$1" in
    ''|0|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

is_owned_group_leader() {
  leader="$1"
  is_positive_pid "$leader" || return 1
  owned_child_alive "$leader" || return 1
  set -- $(/usr/bin/ps -o pid= -o pgid= -o sid= -p "$leader" 2>/dev/null)
  [ "$#" -eq 3 ] && [ "$1" = "$leader" ] && [ "$2" = "$leader" ] && [ "$3" = "$leader" ]
}

capture_owned_vellum_group() {
  # setsid is invoked by this wrapper, then its exact leader is checked as a
  # fresh session/group leader before it becomes group-signal authority.
  attempts=0
  while [ "$attempts" -lt 3 ]; do
    if is_owned_group_leader "$vellum_pid"; then
      vellum_group="$vellum_pid"
      return 0
    fi
    attempts=$((attempts + 1))
    [ "$attempts" -lt 3 ] && sleep 1
  done
  return 1
}

kill_owned_vellum_group() {
  # Escalation is available only while the captured leader still proves that
  # this process group/session is ours. No environment or manager PID is an
  # authority input here.
  [ -n "$vellum_group" ] && [ "$vellum_group" = "$vellum_pid" ] || return 1
  is_owned_group_leader "$vellum_pid" || return 1
  /bin/kill -KILL -- "-$vellum_group"
}

terminate_owned_vellum() {
  [ -n "$vellum_pid" ] || return 0
  # TERM reaches the captured Electron leader only. Chromium helpers get a
  # chance to follow Electron's orderly shutdown instead of dying first.
  kill -TERM "$vellum_pid" 2>/dev/null || true
  if ! wait_bounded_child "$vellum_pid"; then
    kill_owned_vellum_group 2>/dev/null || true
  fi
  wait "$vellum_pid" 2>/dev/null || true
  vellum_pid=''
  vellum_group=''
}

cleanup_owned_resources() {
  if [ -n "$vellum_pid" ]; then
    terminate_owned_vellum
  fi
  if [ -n "$xvfb_pid" ]; then
    kill -TERM "$xvfb_pid" 2>/dev/null || true
    if ! wait_bounded_child "$xvfb_pid"; then
      kill -KILL "$xvfb_pid" 2>/dev/null || true
    fi
    wait "$xvfb_pid" 2>/dev/null || true
    xvfb_pid=''
  fi
}

wait_bounded_child() {
  child="$1"
  deadline=$(( $(date +%s) + 5 ))
  while owned_child_alive "$child"; do
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 1
  done
  return 0
}

if [ -e "$AUTHORITY_DIRECTORY" ] || [ -L "$AUTHORITY_DIRECTORY" ]; then
  printf '%s\n' 'vellum-remote: managed X11 authority is already in use' >&2
  exit 75
fi
mkdir -m 0700 -- "$AUTHORITY_DIRECTORY"
set -C
if ! : > "$XAUTHORITY"; then
  set +C
  printf '%s\n' 'vellum-remote: could not create managed X11 authority' >&2
  exit 73
fi
set +C
trap cleanup_owned_resources EXIT
trap 'cleanup_owned_resources; exit 129' HUP
trap 'cleanup_owned_resources; exit 130' INT
# systemd's deliberate stop is a successful lifecycle outcome. Electron still
# propagates its own unexpected non-zero status through the monitor loop.
trap 'cleanup_owned_resources; exit 0' TERM
if ! "$XAUTH" -f "$XAUTHORITY" add "$DISPLAY" . "$(/usr/bin/mcookie)" >/dev/null 2>&1; then
  printf '%s\n' 'vellum-remote: could not initialize managed X11 authority' >&2
  exit 70
fi
if [ ! -f "$XAUTHORITY" ] || [ -L "$XAUTHORITY" ] || [ ! -O "$XAUTHORITY" ] || \
   [ "$(/usr/bin/stat -c '%a' "$XAUTHORITY" 2>/dev/null || true)" != '600' ]; then
  printf '%s\n' 'vellum-remote: managed X11 authority changed during initialization' >&2
  exit 73
fi

"$XVFB" "$DISPLAY" -screen 0 1280x1024x24 -nolisten tcp -auth "$XAUTHORITY" &
xvfb_pid="$!"

ready_deadline=$(( $(date +%s) + 10 ))
while [ ! -S "$SOCKET_FILE" ]; do
  if ! owned_child_alive "$xvfb_pid"; then
    printf '%s\n' 'vellum-remote: managed display failed to start' >&2
    exit 70
  fi
  if [ "$(date +%s)" -ge "$ready_deadline" ]; then
    printf '%s\n' 'vellum-remote: managed display start timed out' >&2
    exit 70
  fi
  sleep 1
done

control_socket="$RUNTIME_HOME/.vellum/work/control.sock"
control_token="$RUNTIME_HOME/.vellum/work/token"
socket_before="$(file_identity "$control_socket")"
token_before="$(file_identity "$control_token")"
if [ -e "$READY_RECEIPT" ] || [ -L "$READY_RECEIPT" ]; then
  printf '%s\n' 'vellum-remote: generation readiness receipt already exists' >&2
  exit 75
fi
"$SETSID" "$VELLUM" --vellum-headless --ozone-platform=x11 &
vellum_pid="$!"
if ! capture_owned_vellum_group; then
  printf '%s\n' 'vellum-remote: could not verify managed product process group' >&2
  exit 70
fi
ready_deadline=$(( $(date +%s) + 30 ))
while :; do
  socket_after="$(file_identity "$control_socket")"
  token_after="$(file_identity "$control_token")"
  if is_owned_private_socket "$control_socket" && is_owned_private_file "$control_token" && \
     [ "$socket_after" != "$socket_before" ] && [ "$token_after" != "$token_before" ] && \
     is_owned_private_file "$READY_RECEIPT" && \
     [ "$(/usr/bin/cat "$READY_RECEIPT" 2>/dev/null || true)" = "$GENERATION" ]; then
    break
  fi
  if ! owned_child_alive "$vellum_pid"; then
    set +e
    wait "$vellum_pid"
    vellum_status="$?"
    set -e
    vellum_pid=''
    vellum_group=''
    exit "$vellum_status"
  fi
  if [ "$(date +%s)" -ge "$ready_deadline" ]; then
    printf '%s\n' 'vellum-remote: product control plane did not become ready for this generation' >&2
    exit 70
  fi
  sleep 1
done
NOTIFY_SOCKET="$SYSTEMD_NOTIFY_SOCKET" "$SYSTEMD_NOTIFY" --ready --status='Vellum work control ready for current generation'
while :; do
  if ! owned_child_alive "$xvfb_pid"; then
    terminate_owned_vellum
    exit 70
  fi
  if ! owned_child_alive "$vellum_pid"; then
    set +e
    wait "$vellum_pid"
    vellum_status="$?"
    set -e
    vellum_pid=''
    vellum_group=''
    exit "$vellum_status"
  fi
  sleep 1
done
