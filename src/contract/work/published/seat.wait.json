            "idle",
            "attention",
            "working",
            "gone",
            "replied"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "until"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  },
