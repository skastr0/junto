{
  "op": "artifact.edit",
  "payload": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "artifact": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "baseVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The version this edit was written against, from show; a stale one is refused with the head"
        },
        "body": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "markdown": {
                  "type": "string"
                }
              },
              "required": [
                "markdown"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "body": {}
              },
              "required": [
                "body"
              ],
              "additionalProperties": false
            }
          ]
        },
        "patches": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "opId",
        "artifact",
        "baseVersion"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  },
  "success": {
    "dialect": "draft-2020-12",
    "schema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "applied"
              ]
            },
            "opId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "artifactId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "disposition",
            "opId",
            "artifactId",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "queued"
              ]
            },
            "opId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "artifactId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "disposition",
            "opId",
            "artifactId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "definitions": {}
  }
}
