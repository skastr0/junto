{
  "op": "task.resume",
  "payload": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "opId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "A task: #42, its id, or a junto:// ref"
        }
      },
      "required": [
        "opId",
        "task"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  },
  "success": {
    "dialect": "draft-2020-12",
    "schema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "applied"
              ]
            },
            "opId": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "number": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "backlog",
                "assigned",
                "working",
                "input-required",
                "in-review",
                "done",
                "canceled",
                "archived"
              ]
            },
            "deliveryError": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "ScopeError",
                    "ClaimConflict",
                    "UnknownTarget",
                    "StaleNodeRef",
                    "InvalidTransition",
                    "RuntimeDown",
                    "AuthError",
                    "InputError",
                    "ProtocolError",
                    "InternalError",
                    "Paused",
                    "Timeout",
                    "ReviewerIsAuthor",
                    "Stale",
                    "NeedsUpdate"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "details": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {},
                    "received": {},
                    "hint": {
                      "type": "string"
                    },
                    "next_step": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "holder": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "caller": {
                      "type": "string"
                    },
                    "missing": {
                      "type": "string"
                    },
                    "messageId": {
                      "type": "string"
                    },
                    "generation": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "agent",
                              "peer",
                              "terminal",
                              "page",
                              "task",
                              "artifacts",
                              "automations",
                              "note",
                              "label",
                              "file",
                              "link",
                              "git",
                              "files",
                              "stub",
                              "region"
                            ]
                          },
                          "nodeId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "itemId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "number": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "nodeId",
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "opId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "machine": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "disposition",
            "opId",
            "taskId",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "queued"
              ]
            },
            "opId": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "disposition",
            "opId",
            "taskId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "definitions": {}
  }
}
