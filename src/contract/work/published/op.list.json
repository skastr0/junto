{
  "op": "op.list",
  "payload": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "refused"
          ]
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "definitions": {}
  },
  "success": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "queued"
                    ]
                  },
                  "opId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "overlay": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "pending"
                            ]
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "at_risk"
                            ]
                          },
                          "refusal": {
                            "type": "object",
                            "properties": {
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "not_in_reach",
                                  "not_permitted",
                                  "unknown_target",
                                  "invalid_input",
                                  "invalid_transition",
                                  "already_held",
                                  "reviewer_is_author",
                                  "stale",
                                  "rebase_conflict",
                                  "depends_on_refused",
                                  "not_available",
                                  "queue_full"
                                ]
                              },
                              "message": {
                                "type": "string"
                              },
                              "expected": {},
                              "next_step": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "reason",
                              "message"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "status",
                          "refusal"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "at_risk"
                            ]
                          },
                          "waiting": {
                            "type": "string",
                            "enum": [
                              "base_not_pulled"
                            ]
                          },
                          "root": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          }
                        },
                        "required": [
                          "status",
                          "waiting",
                          "root"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "state",
                  "opId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "applied"
                    ]
                  },
                  "opId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "made": {
                    "type": "object"
                  }
                },
                "required": [
                  "state",
                  "opId",
                  "made"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "refused"
                    ]
                  },
                  "opId": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "ScopeError",
                          "ClaimConflict",
                          "UnknownTarget",
                          "StaleNodeRef",
                          "InvalidTransition",
                          "RuntimeDown",
                          "AuthError",
                          "InputError",
                          "ProtocolError",
                          "InternalError",
                          "Paused",
                          "Timeout",
                          "ReviewerIsAuthor",
                          "Stale",
                          "NeedsUpdate"
                        ]
                      },
                      "message": {
                        "type": "string"
                      },
                      "details": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "expected": {},
                          "received": {},
                          "hint": {
                            "type": "string"
                          },
                          "next_step": {
                            "type": "string"
                          },
                          "retryable": {
                            "type": "boolean"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          },
                          "holder": {
                            "type": "string"
                          },
                          "target": {
                            "type": "string"
                          },
                          "caller": {
                            "type": "string"
                          },
                          "missing": {
                            "type": "string"
                          },
                          "messageId": {
                            "type": "string"
                          },
                          "generation": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "candidates": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "agent",
                                    "peer",
                                    "terminal",
                                    "page",
                                    "task",
                                    "artifacts",
                                    "automations",
                                    "note",
                                    "label",
                                    "file",
                                    "link",
                                    "git",
                                    "files",
                                    "stub",
                                    "region"
                                  ]
                                },
                                "nodeId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                },
                                "itemId": {
                                  "type": "string",
                                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "number": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "kind",
                                "nodeId",
                                "name"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "opId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          },
                          "machine": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  "root": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  }
                },
                "required": [
                  "state",
                  "opId",
                  "error",
                  "root"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "ops",
        "more"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  }
}
