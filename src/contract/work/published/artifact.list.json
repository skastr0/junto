{
  "op": "artifact.list",
  "payload": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "The Artifacts node: its id, its name, or a junto:// ref"
        },
        "type": {
          "type": "string",
          "enum": [
            "link",
            "document",
            "pad",
            "sheet",
            "file"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    },
    "definitions": {}
  },
  "success": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "type": {
                "type": "string",
                "enum": [
                  "link",
                  "document",
                  "pad",
                  "sheet",
                  "file"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "updatedAt": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "archived": {
                "type": "boolean"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              },
              "labelColours": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "red",
                    "orange",
                    "yellow",
                    "green",
                    "teal",
                    "blue",
                    "purple",
                    "pink"
                  ]
                }
              },
              "pending": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "atRisk": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "opId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "refusal": {
                        "type": "object",
                        "properties": {
                          "reason": {
                            "type": "string",
                            "enum": [
                              "not_in_reach",
                              "not_permitted",
                              "unknown_target",
                              "invalid_input",
                              "invalid_transition",
                              "already_held",
                              "reviewer_is_author",
                              "stale",
                              "rebase_conflict",
                              "depends_on_refused",
                              "not_available",
                              "queue_full"
                            ]
                          },
                          "message": {
                            "type": "string"
                          },
                          "expected": {},
                          "next_step": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "reason",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "opId",
                      "refusal"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "opId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "waiting": {
                        "type": "string",
                        "enum": [
                          "base_not_pulled"
                        ]
                      },
                      "root": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      }
                    },
                    "required": [
                      "opId",
                      "waiting",
                      "root"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "artifactId",
              "nodeId",
              "type",
              "title",
              "version",
              "updatedAt",
              "archived"
            ],
            "additionalProperties": false
          }
        },
        "more": {
          "type": "boolean"
        },
        "pendingUnknown": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "artifacts",
        "more"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  }
}
