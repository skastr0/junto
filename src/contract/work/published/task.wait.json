{
  "op": "task.wait",
  "payload": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "A task: #42, its id, or a junto:// ref"
        },
        "until": {
          "type": "string",
          "enum": [
            "done",
            "input-required",
            "in-review",
            "canceled"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "task",
        "until"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  },
  "success": {
    "dialect": "draft-2020-12",
    "schema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "backlog",
            "assigned",
            "working",
            "input-required",
            "in-review",
            "done",
            "canceled",
            "archived"
          ]
        },
        "epoch": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        }
      },
      "required": [
        "taskId",
        "state",
        "epoch",
        "at"
      ],
      "additionalProperties": false
    },
    "definitions": {}
  }
}
