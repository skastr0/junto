#!/usr/bin/env node
// Fake `codexbar` executable for E2E — emulates the two calls the product
// actually makes (see src/main/vellum/usage/codexbar-source.ts):
//
//   codexbar --version                                   (detection probe)
//   codexbar usage --json                                (primary fetch)
//   codexbar usage --json --provider codex --all-accounts (multi-account enrich)
//
// Scriptability: FAKE_CODEXBAR_SCENARIO points at a JSON file — {mode:
// "healthy"} prints a valid ProviderQuota[] payload, {mode: "malformed"}
// prints non-JSON stdout so the product degrades to a typed parse-error.
// "missing binary" needs no scripting at all — omit this file from PATH.
// See ../codexbar-scenario.ts for the typed shape + helpers.
"use strict";

import { readFileSync } from "node:fs";

const scenarioPath = process.env.FAKE_CODEXBAR_SCENARIO;

const loadScenario = () => {
  if (!scenarioPath) return { mode: "healthy" };
  try {
    return JSON.parse(readFileSync(scenarioPath, "utf8"));
  } catch {
    return { mode: "healthy" };
  }
};

const defaultQuotas = () => [
  {
    provider: "codex",
    source: "cli",
    accountEmail: "fake@example.com",
    loginMethod: "chatgpt",
    usage: {
      primary: { usedPercent: 42, windowMinutes: 300, resetDescription: "resets in 5h" },
      secondary: { usedPercent: 7, windowMinutes: 10080 },
      updatedAt: new Date().toISOString(),
    },
  },
];

const args = process.argv.slice(2);

if (args[0] === "--version") {
  process.stdout.write("codexbar 1.0.0-fake\n");
  process.exit(0);
}

if (args[0] === "usage" && args[1] === "--json") {
  const scenario = loadScenario();
  const allAccounts = args.includes("--all-accounts");

  if (scenario.mode === "malformed") {
    process.stdout.write("not json at all {{{\n");
    process.exit(0);
  }

  if (allAccounts) {
    // Enrich stage — never load-bearing for the primary paint; empty is a
    // valid "nothing to merge" answer.
    process.stdout.write("[]\n");
    process.exit(0);
  }

  const quotas = scenario.quotas ?? defaultQuotas();
  process.stdout.write(`${JSON.stringify(quotas)}\n`);
  process.exit(0);
}

process.stderr.write(`fake codexbar: unsupported args '${args.join(" ")}'\n`);
process.exitCode = 1;
