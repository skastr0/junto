#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="$(sed -n 's/.*"packageManager": "bun@\([^"]*\)".*/\1/p' package.json)"
if [[ -z "$bun_version" ]]; then
  printf '[setup] error: package.json must declare packageManager as bun@<version>\n' >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "$bun_version" ]]; then
  printf '[setup] Installing Bun %s\n' "$bun_version"
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v${bun_version}"

  mkdir -p "$HOME/.local/bin"
  ln -sfn "$BUN_INSTALL/bin/bun" "$HOME/.local/bin/bun"
  ln -sfn "$BUN_INSTALL/bin/bunx" "$HOME/.local/bin/bunx"
  export PATH="$HOME/.local/bin:$PATH"
fi

printf '[setup] Using Bun %s\n' "$(bun --version)"

install_dependencies() {
  local directory="$1"
  local started_at=$SECONDS

  printf '[setup] Installing dependencies in %s\n' "$directory"
  (
    cd "$repo_root/$directory"
    bun install --frozen-lockfile
  )
  printf '[setup] Dependencies ready in %s (%ss)\n' "$directory" "$((SECONDS - started_at))"
}

install_dependencies .
install_dependencies infra/cloudflare

printf '[setup] Complete\n'
