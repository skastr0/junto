{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/junto-plugin.ts"],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["node_modules/**", "out/**", "dist/**", "infra/**", ".amp/**", "native/**"],
  "rules": {
    "junto/program-imports": [
      "error",
      {
        "aliases": {
          "@shared/*": "src/shared/*",
          "@main/*": "src/main/*",
          "@renderer/*": "src/renderer/*",
          "@junto/overlay": "src/overlay-oss/index.ts",
          "@junto/overlay/*": "src/overlay-oss/*"
        },
        "programs": [
          {
            "name": "shared",
            "paths": ["src/shared/"],
            "mayImport": ["overlay"],
            "forbidModules": ["electron"]
          },
          {
            "name": "overlay",
            "paths": ["src/overlay-oss/"],
            "mayImport": ["shared"],
            "forbidModules": ["electron"]
          },
          {
            "name": "window",
            "paths": ["src/renderer/"],
            "mayImport": ["shared", "overlay"],
            "forbidModules": ["electron"]
          },
          {
            "name": "preload",
            "paths": ["src/preload/"],
            "mayImport": ["shared"]
          },
          {
            "name": "app",
            "paths": ["src/main/"],
            "mayImport": ["shared", "overlay", "core", "terminal"]
          },
          {
            "name": "core",
            "paths": [
              "src/main/core-process/entry.ts",
              "src/main/core-process/serve.ts",
              "src/main/core-process/ops/",
              "src/main/headless.ts"
            ],
            "mayImport": ["shared", "overlay", "app"],
            "forbidModules": ["electron"]
          },
          {
            "name": "terminal",
            "paths": [
              "src/main/terminal-process/entry.ts",
              "src/main/terminal-process/serve.ts",
              "src/main/terminal-process/protocol.ts"
            ],
            "mayImport": ["shared", "app"],
            "forbidModules": ["electron"]
          },
          {
            "name": "cli",
            "paths": ["src/cli/", "src/cli.ts"],
            "mayImport": ["shared", "app"],
            "forbidModules": ["electron"]
          }
        ]
      }
    ]
  }
}
