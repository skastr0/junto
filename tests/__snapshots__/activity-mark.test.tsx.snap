// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ActivityMark visual structure snapshots > pulse/green structure 1`] = `"<span role="status" aria-label="complete" title="complete" data-activity-mode="pulse" data-activity-tone="green" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="vellum-activity-pulse-layer" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px"><span style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:2;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span></span></span>"`;

exports[`ActivityMark visual structure snapshots > static/steel structure 1`] = `"<span role="status" aria-label="idle" title="idle" data-activity-mode="static" data-activity-tone="steel" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="vellum-activity-static-dot" style="display:inline-block;width:12px;height:12px;border-radius:999px;background:var(--color-steel);box-shadow:none"></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/amber structure 1`] = `"<span role="status" aria-label="attention" title="attention" data-activity-mode="wave" data-activity-tone="amber" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="vellum-activity-wave-track" aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber)"></span></span><span class="vellum-activity-wave-head" aria-hidden="true" style="position:absolute;left:0;top:0;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-step:6px"></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/crimson structure 1`] = `"<span role="status" aria-label="blocked" title="blocked" data-activity-mode="wave" data-activity-tone="crimson" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="vellum-activity-wave-track" aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson)"></span></span><span class="vellum-activity-wave-head" aria-hidden="true" style="position:absolute;left:0;top:0;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-step:6px"></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/cyan structure 1`] = `"<span role="status" aria-label="working" title="working" data-activity-mode="wave" data-activity-tone="cyan" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="vellum-activity-wave-track" aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span><span class="vellum-activity-wave-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan)"></span></span><span class="vellum-activity-wave-head" aria-hidden="true" style="position:absolute;left:0;top:0;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-step:6px"></span></span>"`;
