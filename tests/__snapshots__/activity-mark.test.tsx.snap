// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ActivityMark visual structure snapshots > pulse/green structure 1`] = `"<span role="status" aria-label="complete" title="complete" class="junto-activity-mark" data-activity-mode="pulse" data-activity-tone="green" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px"><span class="junto-activity-pulse-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:2;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span><span class="junto-activity-pulse-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-green)"></span></span></span>"`;

exports[`ActivityMark visual structure snapshots > static/steel structure 1`] = `"<span role="status" aria-label="idle" title="idle" class="junto-activity-mark" data-activity-mode="static" data-activity-tone="steel" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span class="junto-activity-static-dot" style="display:inline-block;width:12px;height:12px;border-radius:999px;background:var(--color-steel);box-shadow:none"></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/amber structure 1`] = `"<span role="status" aria-label="attention" title="attention" class="junto-activity-mark" data-activity-mode="wave" data-activity-tone="amber" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:0"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:1"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:2"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:3"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:4"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:5"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:6"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-amber);--activity-clock-step:7"></span></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/crimson structure 1`] = `"<span role="status" aria-label="blocked" title="blocked" class="junto-activity-mark" data-activity-mode="wave" data-activity-tone="crimson" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:0"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:1"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:2"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:3"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:4"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:5"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:6"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-crimson);--activity-clock-step:7"></span></span></span>"`;

exports[`ActivityMark visual structure snapshots > wave/cyan structure 1`] = `"<span role="status" aria-label="working" title="working" class="junto-activity-mark" data-activity-mode="wave" data-activity-tone="cyan" data-activity-size="node" style="display:inline-flex;width:16px;height:16px;align-items:center;justify-content:center;flex-shrink:0;line-height:0;position:relative;vertical-align:middle"><span aria-hidden="true" style="display:inline-grid;grid-template-columns:repeat(3, 4px);grid-template-rows:repeat(3, 4px);gap:2px;position:absolute;inset:0"><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:0"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:1"></span><span class="junto-activity-clock-cell" style="grid-row:1;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:2"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:3"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:3;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:4"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:2;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:5"></span><span class="junto-activity-clock-cell" style="grid-row:3;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:6"></span><span class="junto-activity-clock-cell" style="grid-row:2;grid-column:1;width:4px;height:4px;border-radius:1px;background-color:var(--color-cyan);--activity-clock-step:7"></span></span></span>"`;
