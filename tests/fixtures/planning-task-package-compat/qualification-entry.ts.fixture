import { readFileSync } from "node:fs";
import { Result } from "effect";
import { tasksCreateSchema } from "./src/cli/core/discovery";
import { CURRENT_STATE_SCHEMA_VERSION } from "./src/main/vellum/state/migrations";
import {
  evaluateSchemaCompatibility,
  probeInstalledStateSchema,
} from "./src/main/vellum/state/schema-version-probe";
import {
  CURRENT_STATION_PROTOCOL_SUPPORT,
  STATION_PROTOCOL_BASELINE,
  negotiateStationProtocol,
  selectStationProtocolCodec,
  stationProtocolReject,
} from "./src/shared/station-protocol";
import { WORK_PROTOCOL, decodeWorkRecord } from "./src/shared/work-protocol";

const resultValue = <A, E>(result: Result.Result<A, E>): unknown =>
  Result.isSuccess(result)
    ? { ok: true, value: result.success }
    : { ok: false, error: String(result.failure) };

const decodeSummary = (record: unknown): unknown => {
  const result = decodeWorkRecord(record);
  return Result.isSuccess(result)
    ? { accepted: true }
    : {
        accepted: false,
        error: String(result.failure),
        namesAdmission: /admission/u.test(String(result.failure)),
        namesRaisedBy: /raisedBy/u.test(String(result.failure)),
      };
};

const stdinJson = (): unknown => JSON.parse(readFileSync(0, "utf8"));
const cohort = () => ({
  tasksCreateSchemaId: tasksCreateSchema.schema_id,
  stateSchemaVersion: CURRENT_STATE_SCHEMA_VERSION,
  stationProtocolBaseline: STATION_PROTOCOL_BASELINE,
  stationProtocolSupport: CURRENT_STATION_PROTOCOL_SUPPORT,
  workProtocol: WORK_PROTOCOL,
});
const rejection = () =>
  stationProtocolReject({
    appVersion: "qualification-probe",
    stateSchemaVersion: CURRENT_STATE_SCHEMA_VERSION,
    support: CURRENT_STATION_PROTOCOL_SUPPORT,
  });

const command = process.argv[2];
let output: unknown;

switch (command) {
  case "cohort":
    output = cohort();
    break;
  case "decode-work-record":
    output = resultValue(decodeWorkRecord(stdinJson()));
    break;
  case "matrix": {
    const input = stdinJson() as {
      readonly records: Readonly<Record<string, unknown>>;
      readonly peer: typeof CURRENT_STATION_PROTOCOL_SUPPORT;
      readonly guardedRecord: unknown;
    };
    const negotiation = negotiateStationProtocol(
      CURRENT_STATION_PROTOCOL_SUPPORT,
      input.peer,
    );
    let versionedDecoderInvocations = 0;
    const guardedDecode = negotiation._tag === "no-common"
      ? { accepted: false, reason: "no-common-version" }
      : (() => {
          const codec = selectStationProtocolCodec(negotiation.selected);
          if (Result.isFailure(codec)) {
            return { accepted: false, reason: String(codec.failure) };
          }
          versionedDecoderInvocations += 1;
          return decodeSummary(input.guardedRecord);
        })();
    output = {
      cohort: cohort(),
      records: Object.fromEntries(
        Object.entries(input.records).map(([name, record]) => [
          name,
          decodeSummary(record),
        ]),
      ),
      negotiation,
      localCodecForPeerPreferred: resultValue(
        selectStationProtocolCodec(input.peer.preferred),
      ),
      guarded: {
        versionedDecoderInvocations,
        result: guardedDecode,
        ...(negotiation._tag === "no-common"
          ? { rejection: rejection() }
          : {}),
      },
    };
    break;
  }
  case "schema-probe": {
    const path = process.argv[3];
    if (path === undefined) throw new TypeError("schema-probe requires a path");
    const probe = probeInstalledStateSchema(path);
    output = { probe, compatibility: evaluateSchemaCompatibility(probe) };
    break;
  }
  default:
    throw new TypeError(`unknown command: ${String(command)}`);
}

process.stdout.write(`${JSON.stringify(output)}\n`);
