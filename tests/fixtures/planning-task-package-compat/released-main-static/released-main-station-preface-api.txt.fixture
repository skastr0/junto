const STATION_PROTOCOL_BASELINE = 5;
const StationProtocolVersion = Schema.Number.pipe(
  Schema.check(Schema.isInt()),
  Schema.check(Schema.isGreaterThan(0)),
  Schema.check(Schema.makeFilter(Number.isSafeInteger, {
    message: "Station protocol version must be a safe integer"
  }))
);
const StationProtocolSupport = Schema.Struct({
  preferred: StationProtocolVersion,
  compatibleFrom: StationProtocolVersion,
  warnBelow: StationProtocolVersion
}).pipe(
  Schema.check(Schema.makeFilter(
    ({ compatibleFrom, warnBelow, preferred }) => compatibleFrom <= warnBelow && warnBelow <= preferred,
    {
      message: "Station protocol support must satisfy compatibleFrom <= warnBelow <= preferred"
    }
  ))
);
const CURRENT_STATION_PROTOCOL_SUPPORT = StationProtocolSupport.make({
  preferred: STATION_PROTOCOL_BASELINE,
  compatibleFrom: STATION_PROTOCOL_BASELINE,
  warnBelow: STATION_PROTOCOL_BASELINE
});
const negotiateStationProtocol = (local, peer) => {
  const compatibleFrom = Math.max(local.compatibleFrom, peer.compatibleFrom);
  const selected = Math.min(local.preferred, peer.preferred);
  if (compatibleFrom > selected) {
    return { _tag: "no-common", local, peer };
  }
  const deprecatedForLocal = selected < local.warnBelow;
  const deprecatedForPeer = selected < peer.warnBelow;
  return {
    _tag: "selected",
    selected,
    deprecatedForLocal,
    deprecatedForPeer,
    warning: deprecatedForLocal || deprecatedForPeer
  };
};
const StationAppVersion = Schema.NonEmptyString.pipe(
  Schema.check(Schema.isMaxLength(64))
);
const StationStateSchemaVersion = Schema.Number.pipe(
  Schema.check(Schema.isInt()),
  Schema.check(Schema.isGreaterThan(0)),
  Schema.check(Schema.makeFilter(Number.isSafeInteger, {
    message: "state schema version must be a safe integer"
  }))
);
const STATION_PROTOCOL_PREFACE = "vellum-command/station-protocol-preface/v1";
const StationProtocolPeerDiagnostics = {
  appVersion: StationAppVersion,
  stateSchemaVersion: StationStateSchemaVersion,
  support: StationProtocolSupport
};
const StationProtocolOffer = Schema.Struct({
  protocol: Schema.Literal(STATION_PROTOCOL_PREFACE),
  frame: Schema.Literal("offer"),
  ...StationProtocolPeerDiagnostics
});
const StationProtocolAccept = Schema.Struct({
  protocol: Schema.Literal(STATION_PROTOCOL_PREFACE),
  frame: Schema.Literal("accept"),
  ...StationProtocolPeerDiagnostics,
  selected: StationProtocolVersion
});
const StationProtocolReject = Schema.Struct({
  protocol: Schema.Literal(STATION_PROTOCOL_PREFACE),
  frame: Schema.Literal("reject"),
  ...StationProtocolPeerDiagnostics,
  reason: Schema.Literal("no-common-version"),
  retryable: Schema.Literal(false)
});
const StationProtocolPreface = Schema.Union([
  StationProtocolOffer,
  StationProtocolAccept,
  StationProtocolReject
]);
const decodeStationProtocolPreface = Schema.decodeUnknownResult(
  StationProtocolPreface,
  { onExcessProperty: "error" }
);
const decideStationProtocolPreface = (offer, response2) => {
  const negotiation = negotiateStationProtocol(offer.support, response2.support);
  if (response2.frame === "accept") {
    if (negotiation._tag === "no-common" || response2.selected !== negotiation.selected) {
      return {
        _tag: "invalid-accept",
        expected: negotiation._tag === "selected" ? negotiation.selected : offer.support.compatibleFrom,
        received: response2.selected
      };
    }
    return {
      _tag: "accepted",
      selected: negotiation.selected,
      warning: negotiation.warning,
      deprecatedForOfferer: negotiation.deprecatedForLocal,
      deprecatedForAcceptor: negotiation.deprecatedForPeer
    };
  }
  return negotiation._tag === "no-common" ? { _tag: "no-common" } : { _tag: "invalid-reject" };
};
const stationProtocolAccept = (offer, diagnostics) => {
  const negotiation = negotiateStationProtocol(offer.support, diagnostics.support);
  if (negotiation._tag === "no-common") {
    throw new TypeError("Cannot accept Station protocol with no common version");
  }
  return StationProtocolAccept.make({
    protocol: STATION_PROTOCOL_PREFACE,
    frame: "accept",
    ...diagnostics,
    selected: negotiation.selected
  });
};
const stationProtocolReject = (diagnostics) => StationProtocolReject.make({
  protocol: STATION_PROTOCOL_PREFACE,
  frame: "reject",
  ...diagnostics,
  reason: "no-common-version",
  retryable: false
});
const selectStationProtocolCodec = (version2) => version2 === STATION_PROTOCOL_BASELINE ? Result.succeed(STATION_PROTOCOL_BASELINE) : Result.fail("unsupported-station-protocol");
const STATION_API_PROTOCOL = `vellum-command/station-api/v${STATION_PROTOCOL_BASELINE}`;
